# Supabase project (public values, safe for the browser)
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Optional TURN relay (recommended for production). Leave empty to use STUN only.
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Translation provider: supabase-fn (default, uses the translate-text edge function)
# or libretranslate (self-hosted, LibreTranslate compatible endpoint)
VITE_TRANSLATION_PROVIDER=supabase-fn
VITE_LIBRETRANSLATE_URL=
VITE_LIBRETRANSLATE_API_KEY=

# Development only: use an in-browser BroadcastChannel for WebRTC signaling
# (two tabs in the same browser profile) instead of Supabase Realtime.
VITE_E2E_LOCAL_SIGNALING=0
